<Project Sdk="Microsoft.NET.Sdk">
  <!-- Windows shell of Browser Workbench: a WebView2 window around the bundled Python backend.
       .NET Framework 4.8 ships with Windows 10 and 11, so nothing extra has to be installed;
       it also builds on a Mac (scripts/build_windows.sh) through EnableWindowsTargeting. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <AssemblyName>BrowserWorkbench</AssemblyName>
    <RootNamespace>BrowserWorkbench</RootNamespace>
    <Product>Browser Workbench</Product>
    <Company>Browser Workbench contributors</Company>
    <Copyright>Browser Workbench contributors</Copyright>
    <Version>0.0.0</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!-- Keep the build machine's paths out of the program. -->
    <Deterministic>true</Deterministic>
    <PathMap>$(MSBuildProjectDirectory)=.</PathMap>
    <DebugType>none</DebugType>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <SatelliteResourceLanguages>none</SatelliteResourceLanguages>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System.Drawing" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Web.Extensions" />
    <Reference Include="System.Windows.Forms" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
  </ItemGroup>
</Project>
